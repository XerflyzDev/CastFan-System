{
  "name": "castfan-cloudflare-edge",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker edge gateway for the CastFan Cloud Run service",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=20"
  }
}
